{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "rpiserver debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/rpiserver/src/rpiserver",
            "args": ["--host", "127.0.0.1", "--port", "8000", "--verbose"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/rpiserver",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "rpiserver build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
